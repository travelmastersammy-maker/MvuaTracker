# ==========================================
# MvuaTracker Environment Configuration
# ==========================================

# Server Port
PORT=4173
NODE_ENV=development

# Meteorological & Weather Data Providers
WEATHER_API_KEY=your_weather_api_key_here
SATELLITE_FEED_ENDPOINT=https://api.example-meteorology.org/v1

# Database & Caching (if applicable)
DATABASE_URL=postgresql://username:password@localhost:5432/mvuatracker

# Atmospheric Model Blending Defaults
DEFAULT_GFS_WEIGHT=0.6
DEFAULT_ECMWF_WEIGHT=0.4
